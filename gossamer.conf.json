{
  "$schema": "https://gossamer.dev/schemas/config/v1",
  "productName": "DotMatrix-FilePrinter",
  "version": "1.0.0",
  "identifier": "com.hyperpolymath.dotmatrix-fileprinter",
  "build": {
    "frontendDist": "./dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "deno task dev",
    "beforeBuildCommand": "deno task build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DotMatrix-FilePrinter",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "maxWidth": null,
        "maxHeight": null,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "alwaysOnTop": false,
        "visible": true,
        "url": "/"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": [
        "filesystem",
        "shell",
        "notification"
      ],
      "capabilityTokens": {
        "enabled": false,
        "issuer": "gossamer-runtime",
        "ttl": 3600
      },
      "sandbox": {
        "enabled": true,
        "allowExec": true,
        "allowNetwork": false,
        "allowFilesystem": true
      }
    },
    "ipc": {
      "protocol": "json",
      "bridgeInjection": true,
      "maxMessageSize": 16777216,
      "timeout": 30000
    },
    "tray": {
      "enabled": false,
      "icon": null,
      "tooltip": null,
      "menuOnLeftClick": true
    }
  },
  "plugins": {
    "shell": {
      "scope": [
        {
          "name": "gforth",
          "cmd": "gforth",
          "args": true
        },
        {
          "name": "hexdump",
          "cmd": "hexdump",
          "args": ["-C"]
        }
      ]
    },
    "fs": {
      "scope": {
        "allow": ["$APPDATA/**", "$RESOURCE/**", "kernel/**", "dist/**"],
        "deny": []
      }
    },
    "dialog": {
      "open": true,
      "save": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["kernel/*"],
    "copyright": "Copyright (c) 2026 Jonathan D.A. Jewell (hyperpolymath)",
    "license": "PMPL-1.0-or-later",
    "shortDescription": "Deterministic byte-level filesystem manipulation",
    "longDescription": "A neurosymbolic approach to filesystem manipulation using a Forth kernel as the physical print head for deterministic byte injection.",
    "linux": {
      "desktopEntry": true,
      "category": "Development",
      "section": "devel",
      "depends": ["gforth"],
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macos": {
      "bundleIdentifier": "com.hyperpolymath.dotmatrix-fileprinter",
      "minimumSystemVersion": "11.0",
      "frameworks": [],
      "entitlements": null,
      "signingIdentity": null,
      "notarization": {
        "enabled": false,
        "teamId": null
      }
    },
    "windows": {
      "webview2": "embed",
      "certificateThumbprint": null,
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": null
      }
    },
    "mobile": {
      "ios": {
        "minimumVersion": "14.0",
        "deviceFamily": [
          "iphone",
          "ipad"
        ],
        "capabilities": [],
        "frameworks": [],
        "entitlements": {}
      },
      "android": {
        "minimumSdk": 24,
        "targetSdk": 34,
        "permissions": [],
        "features": []
      }
    }
  },
  "ephapax": {
    "modules": [],
    "region": "app",
    "linearVerification": true,
    "regionBoundary": "strict",
    "preload": []
  }
}
